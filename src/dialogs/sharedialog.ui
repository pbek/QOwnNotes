  <layout class="QGridLayout" name="gridLayout">
   <item row="1" column="0">
    <widget class="QLineEdit" name="passwordLineEdit">
     <property name="toolTip">
      <string>Optional password to protect the shared link, required if your server enforces passwords for shared links</string>
